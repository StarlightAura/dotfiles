{
"layer": "bot",
"spacing": 0,
"height": 0,
"margin-top": 0,
"position": "bottom",
"margin-right": 50,
"margin-bottom": 8,
"margin-left": 50,

"modules-left": [
  "custom/os_btn",
  "hyprland/workspaces"
  //"wlr/taskbar"
],

"modules-center": [
"clock"
],

"modules-right": [
"tray",
"network",
"battery",
"pulseaudio"
],

"hyprland/workspaces": {
"disable-scroll": true,
//"on-scroll-up": "hyprctl dispatch workspace r-1",
//"on-scroll-down": "hyprctl dispatch workspace r+1",
"active-only": false,
"all-outputs": false,
"tooltip": false
//"persistent-workspaces": {
//    "*": 5
//  }
},

"wlr/taskbar": {
  "format": "{icon}",
  "spacing": 3,
  "icon-size": 28,
  "on-click": "activate",
  "tooltip-format": "{title}"
},

"tray": {
"spacing": 10,
"tooltip": false
},

//-------------------------------------------------------------------------------

"clock": {
    "format": "{:%H:%M - %a | %d %b %Y}",
    //"format-alt": "{:%A, %B %d, %Y (%R)}  ",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
        "mode"          : "month",
        "mode-mon-col"  : 3,
        "weeks-pos"     : "right",
        "on-scroll"     : 1,
        "format":  {
            "months":     "<span color='#ffffff'><b>{}</b></span>",
            "days":       "<span color='#ffffff'><b>{}</b></span>",
            "weeks":      "<span color='#55ffff'><b>W{}</b></span>",
            "weekdays":   "<span color='#00ffff'><b>{}</b></span>",
            "today":      "<span color='#00ffff'><b><u>{}</u></b></span>"
        }
    },
    "actions": {
        "on-click-right": "mode",
        "on-scroll-up": "shift_up",
        "on-scroll-down": "shift_down"
    }
},

//-------------------------------------------------------------------------------

//"clock": {
