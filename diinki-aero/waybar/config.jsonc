//              "on-scroll-down": "shift_down"
//              }
//},

//-------------------------------------------------------------------------------

"network": {
"format-wifi" : "󰤢  {bandwidthDownBits}",
"format-ethernet": "󰈀  {bandwidthDownBits}",
"format-disconnected" : "󰤠  No Network",
"interval": 5,
"tooltip": false
},

"pulseaudio": {
"scroll-step": 5,
"max-volume": 150,
"format": "{icon}  {volume}%",
"format-bluetooth": "{icon}  {volume}%",
"format-icons": ["", "", " "],
"nospacing": 1,
"format-muted": " ",
"on-click": "pavucontrol",
"tooltip": false
},

"battery": {
"format": "{icon}  {capacity}%",
"interval": 5,
"states": {
"warning": 20,
"critical": 10
},

"format-icons": ["", "", "", "", ""],
"tooltip": false
}
}
